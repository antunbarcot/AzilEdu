 @page "/animals"

<MudText Typo="Typo.h4" GutterBottom="true">Životinje u azilu</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Pregled životinja koje se nalaze u sustavu azila.
</MudText>
<hr /> 

<MudGrid Spacing="3">
    <MudItem xs="12" md="4" Style="display:grid">
        <MudPaper Class="pa-4" Elevation="2" Style="height:100%">
                <MudImage Src="images/allanimals.png"
                          Alt="Sve životinje"
                          Fluid="true"
                          ObjectFit="ObjectFit.Cover"
                          Height="200"
                          Class="mb-3" />
            <MudText Typo="Typo.h6">Sve životinje</MudText>
            <MudText Typo="Typo.body2">
                Pregled svih životinja evidentiranih u azilu.
            </MudText>
            <MudStack Row="true" Spacing="10">
                <MudButton Variant="Variant.Filled"
                        Color="Color.Primary"
                        Class="mt-3">Otvori pregled</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       Class="mt-3">Botun1</MudButton>
            </MudStack>
            
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4" Style="display:grid">
        <MudPaper Class="pa-4" Elevation="2" Style="height:100%">
            <MudImage Src="images/dogbreeds.png"
                      Alt="Vrste i pasmine"
                      Fluid="true"
                      ObjectFit="ObjectFit.Cover"
                      Height="200"
                      Class="mb-3 rounded-3" />
            <MudText Typo="Typo.h6">Vrste i pasmine</MudText>
            <MudText Typo="Typo.body2">
                Organizacija životinja prema vrstama i pasminama.
            </MudText>
            <MudStack Row="true" Spacing="10">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="mt-3">Otvori pregled</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           Class="mt-3">Botun2</MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4" Style="display:grid">
        <MudPaper Class="pa-4" Elevation="2" Style="height:100%">
            <MudImage Src="images/doghouse.jpg"
                      Alt="Fotografija smještaja"
                      Fluid="true"
                      ObjectFit="ObjectFit.Cover"
                      Height="200"
                      Class="mb-3" />
            <MudText Typo="Typo.h6">Smještaj</MudText>
            <MudText Typo="Typo.body2">
                Pregled bokseva, kaveza i drugih smještajnih jedinica.
            </MudText>

            <MudStack Row="true" Spacing="10">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="mt-3">Otvori pregled</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           Class="mt-3">Botun3</MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>

</MudGrid>




