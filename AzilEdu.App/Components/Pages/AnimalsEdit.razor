@page "/animals/edit/{Id:int}"
@rendermode InteractiveServer

@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" GutterBottom="true">Uredi životinju</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Na ovoj stranici dohvaćamo postojeći zapis i spremamo promjene preko PUT zahtjeva.
</MudText>

@if (!string.IsNullOrWhiteSpace(aiError))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@aiError</MudAlert>
}

@if (aiCheck is not null)
{
    <MudAlert Severity="@(aiCheck.IsReady ? Severity.Success : Severity.Warning)"
              Class="mb-4">
        <MudText>@aiCheck.SuggestedDescription</MudText>
        @foreach (var warning in aiCheck.Warnings)
        {
            <MudText Typo="Typo.body2">• @warning</MudText>
        }
    </MudAlert>
}

<MudForm @ref="form">
    <MudStack Spacing="2">
        <MudTextField @bind-Value="model.Name" Label="Ime" Required="true" />
        <MudTextField @bind-Value="model.Species" Label="Vrsta" Required="true" />
        <MudTextField @bind-Value="model.Breed" Label="Pasmina" />
        <MudTextField @bind-Value="model.Gender" Label="Spol" />
        <MudNumericField @bind-Value="model.Age" Label="Dob" />
        <MudDatePicker @bind-Date="arrivalDate" Label="Datum dolaska" />

        <MudSelect T="int"
                   Label="Status"
                   @bind-Value="model.AnimalStatusId"
                   Variant="Variant.Outlined"
                   Required="true">
            @foreach (var status in statusList)
            {
                <MudSelectItem Value="@status.Id">@status.Name</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="model.ImageUrl" Label="Putanja slike" />
        <MudTextField @bind-Value="model.Description" Label="Opis" Lines="3" />

        <MudStack Row="true" Spacing="2">
            <MudButton ButtonType="ButtonType.Button"
                       OnClick="GenerateDescription"
                       Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Disabled="isGeneratingDescription">
                @(isGeneratingDescription ? "Generiram..." : "AI prijedlog opisa")
            </MudButton>

            <MudButton ButtonType="ButtonType.Button"
                       OnClick="CheckAnimalData"
                       Variant="Variant.Outlined"
                       Color="Color.Info"
                       Disabled="isCheckingData">
                @(isCheckingData ? "Provjeravam..." : "AI provjera podataka")
            </MudButton>
        </MudStack>

        <MudButton ButtonType="ButtonType.Button"
                   OnClick="@UpdateAnimal"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            Spremi promjene
        </MudButton>
    </MudStack>
</MudForm>

@code {
    [Parameter] public int Id { get; set; }

    private MudForm? form;
    private SaveAnimalDto model = new();
    private DateTime? arrivalDate;

    private bool isGeneratingDescription;
    private bool isCheckingData;
    private string? aiError;
    private AnimalDataCheckDto? aiCheck;

    private List<LookupDto> statusList = new();

    protected override async Task OnInitializedAsync()
    {
        statusList = await Http.GetFromJsonAsync<List<LookupDto>>("api/animalstatuses") ?? new();

        var animal = await Http.GetFromJsonAsync<AnimalDto>($"api/animals/{Id}");

        if (animal is not null)
        {
            model = new SaveAnimalDto
            {
                Name = animal.Name,
                Species = animal.Species,
                Breed = animal.Breed,
                Gender = animal.Gender,
                Age = animal.Age,
                ArrivalDate = animal.ArrivalDate,
                AnimalStatusId = animal.AnimalStatusId,
                ImageUrl = animal.ImageUrl,
                Description = animal.Description
            };

            arrivalDate = animal.ArrivalDate;
        }

        if (model.AnimalStatusId == 0 && statusList.Count > 0)
        {
            model.AnimalStatusId = statusList[0].Id;
        }
    }

    private async Task UpdateAnimal()
    {
        if (form is not null)
        {
            await form.ValidateAsync();

            if (!form.IsValid)
            {
                return;
            }
        }

        model.ArrivalDate = arrivalDate;

        var response = await Http.PutAsJsonAsync($"api/animals/{Id}", model);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/animals");
        }
    }

    private async Task GenerateDescription()
    {
        isGeneratingDescription = true;
        aiError = null;

        try
        {
            var input =
                $"Ime: {model.Name}; Vrsta: {model.Species}; " +
                $"Pasmina: {model.Breed}; Spol: {model.Gender}; " +
                $"Starost: {model.Age}; Postojeći opis: {model.Description}.";

            var response = await Http.PostAsJsonAsync("api/ai/text", new AiTextRequestDto
            {
                Purpose = "animal-adoption",
                Input = input
            });

            if (!response.IsSuccessStatusCode)
            {
                aiError = await response.Content.ReadAsStringAsync();
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<AiTextResponseDto>();

            if (!string.IsNullOrWhiteSpace(result?.Text))
                model.Description = result.Text;
        }
        catch (Exception ex)
        {
            aiError = $"AI opis nije moguće generirati: {ex.Message}";
        }
        finally
        {
            isGeneratingDescription = false;
        }
    }

    private async Task CheckAnimalData()
    {
        isCheckingData = true;
        aiError = null;
        aiCheck = null;

        try
        {
            model.ArrivalDate = arrivalDate;
            var response = await Http.PostAsJsonAsync("api/ai/animal-data-check", model);

            if (!response.IsSuccessStatusCode)
            {
                aiError = await response.Content.ReadAsStringAsync();
                return;
            }

            aiCheck = await response.Content.ReadFromJsonAsync<AnimalDataCheckDto>();
        }
        catch (Exception ex)
        {
            aiError = $"AI provjera nije dostupna: {ex.Message}";
        }
        finally
        {
            isCheckingData = false;
        }
    }
}