@page "/donations/edit/{Id:int}"
@rendermode InteractiveServer

@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">Uredi donaciju</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (donationFound)
{
    <EditForm Model="model"
              OnValidSubmit="UpdateDonation"
              FormName="donation-edit">
        <MudPaper Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="int"
                               Label="Donator"
                               @bind-Value="model.DonorId"
                               Required="true"
                               Variant="Variant.Outlined">
                        @foreach (var donor in donors)
                        {
                            <MudSelectItem T="int" Value="@donor.Id">
                                @donor.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="int"
                               Label="Tip donacije"
                               @bind-Value="SelectedDonationTypeId"
                               Required="true"
                               Variant="Variant.Outlined">
                        @foreach (var type in types)
                        {
                            <MudSelectItem T="int" Value="@type.Id">
                                @type.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="int"
                               Label="Status"
                               @bind-Value="model.DonationStatusId"
                               Required="true"
                               Variant="Variant.Outlined">
                        @foreach (var status in statuses)
                        {
                            <MudSelectItem T="int" Value="@status.Id">
                                @status.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudDatePicker Label="Datum donacije"
                                   @bind-Date="donationDate"
                                   DateFormat="dd.MM.yyyy."
                                   MaxDate="DateTime.Today"
                                   Required="true"
                                   Variant="Variant.Outlined" />
                </MudItem>

                @if (IsMoneyDonation)
                {
                    <MudItem xs="12" md="6">
                        <MudNumericField T="decimal?"
                                         Label="Iznos u eurima"
                                         @bind-Value="model.Amount"
                                         Min="0"
                                         Required="true"
                                         Variant="Variant.Outlined" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Naziv donacije"
                                      @bind-Value="model.ItemName"
                                      Required="true"
                                      Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12" md="3">
                        <MudNumericField T="decimal?"
                                         Label="Količina"
                                         @bind-Value="model.Quantity"
                                         Min="0"
                                         Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12" md="3">
                        <MudNumericField T="decimal?"
                                         Label="Procijenjena vrijednost"
                                         @bind-Value="model.EstimatedValue"
                                         Min="0"
                                         Variant="Variant.Outlined" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField Label="Napomena"
                                  @bind-Value="model.Notes"
                                  Lines="4"
                                  Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Spacing="2" Class="mt-4">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="isSaving">
                    @(isSaving ? "Spremam..." : "Spremi promjene")
                </MudButton>

                <MudButton Href="/donations"
                           Variant="Variant.Text"
                           Disabled="isSaving">
                    Odustani
                </MudButton>
            </MudStack>
        </MudPaper>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private SaveDonationDto model = new();
    private List<LookupDto> donors = new();
    private List<LookupDto> types = new();
    private List<LookupDto> statuses = new();

    private DateTime? donationDate;
    private bool isLoading = true;
    private bool isSaving;
    private bool donationFound;
    private string? errorMessage;

    private bool IsMoneyDonation => model.DonationTypeId == 1;

    private int SelectedDonationTypeId
    {
        get => model.DonationTypeId;
        set
        {
            if (model.DonationTypeId == value)
                return;

            model.DonationTypeId = value;

            if (value == 1)
            {
                model.ItemName = string.Empty;
                model.Quantity = null;
                model.EstimatedValue = null;
            }
            else
            {
                model.Amount = null;
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            donors = await Http.GetFromJsonAsync<List<LookupDto>>(
                "api/donors/lookup") ?? new();
            types = await Http.GetFromJsonAsync<List<LookupDto>>(
                "api/donationtypes") ?? new();
            statuses = await Http.GetFromJsonAsync<List<LookupDto>>(
                "api/donationstatuses") ?? new();

            var donation = await Http.GetFromJsonAsync<DonationDto>(
                            $"api/donations/{Id}");

            if (donation is null)
            {
                errorMessage = "Donacija nije pronađena.";
                donationFound = false;
                return;
            }

            model = new SaveDonationDto
            {
                DonorId = donation.DonorId,
                DonationTypeId = donation.DonationTypeId,
                DonationStatusId = donation.DonationStatusId,
                DonationDate = donation.DonationDate,
                Amount = donation.Amount,
                ItemName = donation.ItemName,
                Quantity = donation.Quantity,
                EstimatedValue = donation.EstimatedValue,
                Notes = donation.Notes
            };

            donationDate = donation.DonationDate;
            donationFound = true;
        }
        catch (Exception ex)
        {
            donationFound = false;
            errorMessage = $"Donaciju nije moguće učitati: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateDonation()
    {
        errorMessage = ValidateForm();

        if (errorMessage is not null)
            return;

        isSaving = true;

        try
        {
            model.DonationDate = donationDate!.Value;

            var response = await Http.PutAsJsonAsync(
                            $"api/donations/{Id}",
                            model);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            Navigation.NavigateTo("/donations");
        }
        catch (Exception ex)
        {
            errorMessage = $"Promjene nije moguće spremiti: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private string? ValidateForm()
    {
        if (model.DonorId <= 0)
            return "Odaberi donatora.";

        if (model.DonationTypeId <= 0)
            return "Odaberi tip donacije.";

        if (model.DonationStatusId <= 0)
            return "Odaberi status donacije.";

        if (!donationDate.HasValue)
            return "Odaberi datum donacije.";

        if (donationDate.Value.Date > DateTime.Today)
            return "Datum donacije ne smije biti u budućnosti.";

        if (IsMoneyDonation)
        {
            if (!model.Amount.HasValue || model.Amount.Value <= 0)
                return "Za novčanu donaciju upiši iznos veći od nule.";
        }
        else
        {
            if (string.IsNullOrWhiteSpace(model.ItemName))
                return "Upiši naziv materijalne donacije ili usluge.";

            if (!model.Quantity.HasValue || model.Quantity.Value <= 0)
                return "Upiši količinu veću od nule.";
        }

        if (model.Quantity.HasValue && model.Quantity.Value < 0)
            return "Količina ne smije biti negativna.";

        if (model.EstimatedValue.HasValue && model.EstimatedValue.Value < 0)
            return "Procijenjena vrijednost ne smije biti negativna.";

        return null;
    }
}