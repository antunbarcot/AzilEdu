@page "/donations/edit/{Id:int}"
@rendermode InteractiveServer

@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@using MudBlazor

@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Uredi donaciju</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <EditForm Model="model" OnValidSubmit="SaveDonation" FormName="donation-edit">
        <DataAnnotationsValidator />

        <MudPaper Class="pa-4">
            <ValidationSummary />

            <MudSelect T="int" Label="Donator"
                       @bind-Value="model.DonorId"
                       Required="true"
                       Class="mb-3">
                @foreach (var donor in donors)
                {
                    <MudSelectItem T="int" Value="@donor.Id">@donor.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int" Label="Tip donacije"
                       @bind-Value="model.DonationTypeId"
                       Required="true"
                       Class="mb-3">
                @foreach (var type in types)
                {
                    <MudSelectItem T="int" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int" Label="Status donacije"
                       @bind-Value="model.DonationStatusId"
                       Required="true"
                       Class="mb-3">
                @foreach (var status in statuses)
                {
                    <MudSelectItem T="int" Value="@status.Id">@status.Name</MudSelectItem>
                }
            </MudSelect>

            <MudDatePicker Label="Datum donacije"
                           @bind-Date="donationDate"
                           Required="true"
                           Class="mb-3" />

            @if (IsMonetaryType)
            {
                <MudNumericField T="decimal?" Label="Iznos (€)"
                                 @bind-Value="model.Amount"
                                 Class="mb-3" />
            }
            else
            {
                <MudTextField Label="Naziv stvari"
                              @bind-Value="model.ItemName"
                              Class="mb-3" />

                <MudNumericField T="decimal?" Label="Količina"
                                 @bind-Value="model.Quantity"
                                 Class="mb-3" />

                <MudNumericField T="decimal?" Label="Procijenjena vrijednost (€)"
                                 @bind-Value="model.EstimatedValue"
                                 Class="mb-3" />
            }

            <MudTextField Label="Napomena"
                          @bind-Value="model.Notes"
                          Lines="3"
                          Class="mb-4" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary">
                Spremi promjene
            </MudButton>

            <MudButton Href="/donations"
                       Variant="Variant.Text"
                       Class="ml-2">
                Odustani
            </MudButton>
        </MudPaper>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private SaveDonationDto model = new();
    private DateTime? donationDate;

    private List<LookupDto> donors = new();
    private List<LookupDto> types = new();
    private List<LookupDto> statuses = new();

    private bool isLoading = true;
    private string? errorMessage;

    private bool IsMonetaryType =>
        types.FirstOrDefault(t => t.Id == model.DonationTypeId)?.Name == "Novčana";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            donors = await Http.GetFromJsonAsync<List<LookupDto>>("api/donors/lookup") ?? new();
            types = await Http.GetFromJsonAsync<List<LookupDto>>("api/donationtypes") ?? new();
            statuses = await Http.GetFromJsonAsync<List<LookupDto>>("api/donationstatuses") ?? new();

            var donation = await Http.GetFromJsonAsync<DonationDto>($"api/donations/{Id}");

            if (donation is null)
            {
                errorMessage = "Donacija nije pronađena.";
                return;
            }

            model = new SaveDonationDto
            {
                DonorId = donation.DonorId,
                DonationTypeId = donation.DonationTypeId,
                DonationStatusId = donation.DonationStatusId,
                DonationDate = donation.DonationDate,
                Amount = donation.Amount,
                ItemName = donation.ItemName,
                Quantity = donation.Quantity,
                EstimatedValue = donation.EstimatedValue,
                Notes = donation.Notes
            };

            donationDate = donation.DonationDate;
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod učitavanja donacije: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveDonation()
    {
        model.DonationDate = donationDate ?? DateTime.Today;

        if (IsMonetaryType && !model.Amount.HasValue)
        {
            errorMessage = "Za novčanu donaciju iznos je obavezan.";
            return;
        }

        if (!IsMonetaryType && string.IsNullOrWhiteSpace(model.ItemName))
        {
            errorMessage = "Za materijalnu donaciju naziv stvari je obavezan.";
            return;
        }

        var response = await Http.PutAsJsonAsync($"api/donations/{Id}", model);

        if (!response.IsSuccessStatusCode)
        {
            var message = await response.Content.ReadAsStringAsync();
            errorMessage = string.IsNullOrWhiteSpace(message)
                ? "Promjene nisu spremljene."
                : message;
            return;
        }

        Snackbar.Add("Promjene su uspješno spremljene.", Severity.Success);
        Navigation.NavigateTo("/donations");
    }
}