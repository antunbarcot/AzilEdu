@page "/"
@rendermode InteractiveServer

@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@using AzilEdu.App.Services

@inject CurrentUserService CurrentUser
@inject HttpClient Http

<MudText Typo="Typo.h3" Class="mb-2">AzilEdu</MudText>

<MudText Typo="Typo.body1" Class="mb-6">
    Pregled trenutnog stanja azila.
</MudText>

@if (CurrentUser.HasAnyRole("Admin", "Employee"))
{
    <MudPaper Class="pa-4 mb-6" Elevation="2">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h6">AI dnevni sažetak</MudText>

                @if (providerStatus is not null)
                {
                    <MudText Typo="Typo.caption">
                        Provider: @providerStatus.Provider · Model: @providerStatus.Model
                    </MudText>
                }
            </div>

            <MudButton OnClick="GenerateDailySummary"
                       Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Disabled="isGeneratingAiSummary">
                @(isGeneratingAiSummary ? "Generiram..." : "Generiraj sažetak")
            </MudButton>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(aiSummary))
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">
                @aiSummary
            </MudAlert>
        }
    </MudPaper>
}

@if (isLoading)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Primary" />
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}
else if (summary is null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Sažetak nije dostupan.
    </MudAlert>
}
else
{
    @if (!CurrentUser.IsLoggedIn)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Prijavi se da vidiš dashboard prema svojoj ulozi.
        </MudAlert>
    }
    else if (CurrentUser.HasRole("Admin"))
    {
        <MudText Typo="Typo.h5" Class="mb-4">
            Administratorski pregled cijelog sustava
        </MudText>
    }
    else if (CurrentUser.HasRole("Employee"))
    {
        <MudText Typo="Typo.h5" Class="mb-4">
            Operativni pregled azila
        </MudText>
    }
    else if (CurrentUser.HasRole("Volunteer"))
    {
        <MudText Typo="Typo.h5" Class="mb-4">
            Dobrodošao/la. Pogledaj svoje volonterske zadatke.
        </MudText>
    }
    else if (CurrentUser.HasRole("Donor"))
    {
        <MudText Typo="Typo.h5" Class="mb-4">
            Hvala na podršci azilu. Ovdje možeš vidjeti svoje donacije.
        </MudText>
    }

    @if (CurrentUser.HasRole("Volunteer") && myUnfinishedTasksCount.HasValue)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.AssignmentInd"
                         Color="Color.Warning"
                         Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.subtitle2">Tvoji nezavršeni zadaci</MudText>
                    <MudText Typo="Typo.h4">@myUnfinishedTasksCount</MudText>
                </div>
            </MudStack>
        </MudPaper>
    }

    @if (CurrentUser.HasRole("Donor") && myDonationsCount.HasValue)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.CardGiftcard"
                         Color="Color.Success"
                         Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.subtitle2">Tvoje donacije</MudText>
                    <MudText Typo="Typo.h4">@myDonationsCount</MudText>
                </div>
            </MudStack>
        </MudPaper>
    }

    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Pets"
                             Color="Color.Primary"
                             Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2">Ukupno životinja</MudText>
                        <MudText Typo="Typo.h4">@summary.AnimalsCount</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Favorite"
                             Color="Color.Success"
                             Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2">Dostupno za udomljenje</MudText>
                        <MudText Typo="Typo.h4">@summary.AvailableAnimalsCount</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.VolunteerActivism"
                             Color="Color.Info"
                             Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2">Aktivni volonteri</MudText>
                        <MudText Typo="Typo.h4">@summary.ActiveVolunteersCount</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment"
                             Color="Color.Warning"
                             Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2">Otvoreni zadaci</MudText>
                        <MudText Typo="Typo.h4">@summary.OpenVolunteerTasksCount</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Groups"
                             Color="Color.Secondary"
                             Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2">Aktivni donatori</MudText>
                        <MudText Typo="Typo.h4">@summary.ActiveDonorsCount</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Badge"
                             Color="Color.Dark"
                             Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2">Djelatnici</MudText>
                        <MudText Typo="Typo.h4">@summary.EmployeesCount</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.CardGiftcard"
                             Color="Color.Primary"
                             Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2">Ukupno donacija</MudText>
                        <MudText Typo="Typo.h4">@summary.DonationsCount</MudText>
                        <MudText Typo="Typo.caption">
                            @summary.PendingDonationsCount čeka obradu
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Euro"
                             Color="Color.Success"
                             Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2">Novčane donacije</MudText>
                        <MudText Typo="Typo.h4">
                            @($"{summary.MoneyDonationsTotal:N2} €")
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2"
                             Color="Color.Secondary"
                             Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2">Materijalne donacije</MudText>
                        <MudText Typo="Typo.h4">
                            @($"{summary.EstimatedMaterialDonationsTotal:N2} €")
                        </MudText>
                        <MudText Typo="Typo.caption">procijenjena vrijednost</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (summary.OverdueVolunteerTasksCount > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-6">
            Broj zakašnjelih volonterskih zadataka:
            <strong>@summary.OverdueVolunteerTasksCount</strong>.
            Otvori stranicu zadataka i provjeri rokove.
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Success" Class="mt-6">
            Nema zakašnjelih volonterskih zadataka.
        </MudAlert>
    }

    <MudPaper Class="pa-4 mt-6" Elevation="2">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween"
                  Class="mb-3">
            <MudText Typo="Typo.h5">Zadnjih pet donacija</MudText>

            <MudButton Href="/donations"
                       Variant="Variant.Text"
                       Color="Color.Primary">
                Prikaži sve
            </MudButton>
        </MudStack>

        <MudTable Items="recentDonations"
                  Hover="true"
                  Dense="true"
                  Bordered="true">
            <HeaderContent>
                <MudTh>Donator</MudTh>
                <MudTh>Tip</MudTh>
                <MudTh>Vrijednost</MudTh>
                <MudTh>Datum</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Donator">@context.DonorName</MudTd>
                <MudTd DataLabel="Tip">@context.DonationType</MudTd>
                <MudTd DataLabel="Vrijednost">
                    @GetRecentDonationDisplay(context)
                </MudTd>
                <MudTd DataLabel="Datum">
                    @context.DonationDate.ToString("dd.MM.yyyy.")
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText Typo="Typo.body1" Class="pa-4">
                    Još nema evidentiranih donacija.
                </MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private DashboardSummaryDto? summary;
    private List<RecentDonationDto> recentDonations = new();

    private int? myUnfinishedTasksCount;
    private int? myDonationsCount;

    private bool isLoading = true;
    private string? errorMessage;
    private string? aiSummary;
    private bool isGeneratingAiSummary;
    private AiProviderStatusDto? providerStatus;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (CurrentUser.HasAnyRole("Admin", "Employee"))
            {
                providerStatus =
                    await Http.GetFromJsonAsync<AiProviderStatusDto>(
                        "api/ai/status");
            }
            summary = await Http.GetFromJsonAsync<DashboardSummaryDto>(
                "api/dashboard/summary");

            recentDonations = await Http.GetFromJsonAsync<List<RecentDonationDto>>(
                "api/dashboard/recent-donations") ?? new();

            if (CurrentUser.HasRole("Volunteer") && CurrentUser.User?.VolunteerId is not null)
            {
                var tasks = await Http.GetFromJsonAsync<List<VolunteerTaskDto>>(
                    $"api/volunteertasks?volunteerId={CurrentUser.User.VolunteerId}") ?? new();

                myUnfinishedTasksCount = tasks.Count(task => task.Status != "Završeno");
            }

            if (CurrentUser.HasRole("Donor") && CurrentUser.User?.DonorId is not null)
            {
                var donations = await Http.GetFromJsonAsync<List<DonationDto>>(
                    $"api/donations?donorId={CurrentUser.User.DonorId}") ?? new();

                myDonationsCount = donations.Count;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Dashboard nije moguće učitati: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetRecentDonationDisplay(RecentDonationDto donation)
    {
        if (donation.Amount.HasValue && donation.Amount.Value > 0)
            return $"{donation.Amount.Value:N2} €";

        if (!string.IsNullOrWhiteSpace(donation.ItemName))
            return donation.ItemName;

        return "Nije navedeno";
    }

    private async Task GenerateDailySummary()
    {
        isGeneratingAiSummary = true;
        errorMessage = null;

        try
        {
            var result = await Http.GetFromJsonAsync<AiTextResponseDto>(
                "api/ai/daily-summary");
            aiSummary = result?.Text;
        }
        catch (Exception ex)
        {
            errorMessage = $"AI sažetak nije dostupan: {ex.Message}";
        }
        finally
        {
            isGeneratingAiSummary = false;
        }
    }
}

