@page "/housing-units"
@using AzilEdu.Shared.Models

<MudText Typo="Typo.h4" GutterBottom="true">Smještajne jedinice</MudText>

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.body1">
        Ovdje će se prikazivati boksevi, sobe i drugi prostori u kojima se životinje nalaze.
    </MudText>
</MudPaper>

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Ukupan broj jedinica</MudText>
            <MudText Typo="Typo.h5">@TotalAnimals</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Broj aktivnih jedinica</MudText>
            <MudText Typo="Typo.h5">@AnimalsInShelter</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Broj punih jedinica</MudText>
            <MudText Typo="Typo.h5">@AdoptedAnimals</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Ukupan slobodni kapacitet</MudText>
            <MudText Typo="Typo.h5">@DogsCount</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Class="mb-4"
    <MudButton OnClick="@ShowAllAnimals">Sve</MudButton>
    <MudButton OnClick="@ShowAnimalsInShelter">Samo aktivne</MudButton>
    <MudButton OnClick="@ShowAdoptedAnimals">Samo pune</MudButton>
    <MudButton OnClick="@ShowAdoptedAnimals">Samo slobodne</MudButton>
</MudButtonGroup>

<MudTable Items="@FilteredUnits" Hover="true" Striped="true" Bordered="true" Dense="true">
    <HeaderContent>
        <MudTh>Slika</MudTh>
        <MudTh>Naziv</MudTh>
        <MudTh>Tip</MudTh>
        <MudTh>Kapacitet</MudTh>
        <MudTh>Zauzeto</MudTh>
        <MudTh>Slobodno</MudTh>
        <MudTh>Zadnje čišćenje</MudTh>
        <MudTh>Status</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Slika">
            <MudAvatar Size="Size.Large">
                <MudImage Src="@context.ImageUrl" Alt="@context.Name" />
            </MudAvatar>
        </MudTd>
        <MudTd DataLabel="Ime">@context.Name</MudTd>
        <MudTd DataLabel="Vrsta">@context.Species</MudTd>
        <MudTd DataLabel="Pasmina">@context.Breed</MudTd>
        <MudTd DataLabel="Spol">@context.Gender</MudTd>
        <MudTd DataLabel="Starost">@GetAgeText(context)</MudTd>
        <MudTd DataLabel="Datum dolaska">@GetArrivalDateText(context)</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string"
                     Color="@(context.IsAdopted ? Color.Success : Color.Warning)"
                     Variant="Variant.Filled">
                @GetAdoptionStatusText(context)
            </MudChip>
        </MudTd>
    </RowTemplate>
</MudTable>