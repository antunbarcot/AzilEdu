@page "/status"
@* @rendermode InteractiveServer

<h1>Status aplikacije</h1>

<p class="@statusKlasa">@poruka</p>

<button @onclick="UkljuciUpozorenje">Prikaži upozorenje</button>

@code {
    string poruka = "Sve je u redu.";
    string statusKlasa = "status-ok";

    void UkljuciUpozorenje()
    {
        poruka = "Potrebna je provjera.";
        statusKlasa = "status-upozorenje";
    }
} *@
<MudButton Color="Color.Primary">Spremi</MudButton>
<MudText Typo="Typo.h4">Species</MudText>
<MudText Typo="Typo.subtitle1">Subtitle 1</MudText>
<MudText Typo="Typo.subtitle2">Subtitle 2</MudText>
<MudText Typo="Typo.caption">Caption</MudText>

<MudStack Spacing="1">
    <MudText Typo="Typo.h5" Color="Color.Primary">Animals</MudText>
    <MudText Typo="Typo.h6" Color="Color.Success">Podaci su uspješno spremljeni</MudText>
    <MudText Typo="Typo.body2" Color="Color.Error">Došlo je do greške</MudText>
</MudStack>

<MudText Typo="Typo.h4" GutterBottom="true">
    Species
</MudText>

<MudText Typo="Typo.body1" Align="Align.Center">
    Dobro došli u AzilEdu
</MudText>
<MudStack Spacing="2">
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6">Species</MudText>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="4">
        <MudText Typo="Typo.h6">Adopters</MudText>
    </MudPaper>

    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.h6">Housing Units</MudText>
    </MudPaper>

    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h5">Animals</MudText>
        <MudText Typo="Typo.body2">Kartica s više unutarnjeg razmaka.</MudText>
    </MudPaper>
</MudStack>
<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">Animals</MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">Species</MudPaper>
    </MudItem>
</MudGrid>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4">Animals</MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4">Species</MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4">Adopters</MudPaper>
    </MudItem>
</MudGrid>

<MudGrid>
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4">Glavni sadržaj</MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4">Bočni sadržaj</MudPaper>
    </MudItem>
</MudGrid>
<MudButton StartIcon="@Icons.Material.Filled.Add"
           Variant="Variant.Filled"
           Color="Color.Primary">
    Dodaj
</MudButton>

<MudButton EndIcon="@Icons.Material.Filled.ArrowForward"
           Variant="Variant.Outlined"
           Color="Color.Secondary">
    Nastavi
</MudButton>

@*nedostaje lista u code*@
<hr/>
<MudText Typo="Typo.h2">Slike</MudText>
<MudImage Src="images/bobtail.jpg" Alt="Pas vrsta BobTail" Fluid="true"></MudImage>
<MudPaper Class="pa-4" Elevation="2">
    <MudImage Src="images/bobtail.jpg"
              Alt="Pas Rex"
              Width="250"
              Class="mb-2" />

    <MudText Typo="Typo.h6">Rex</MudText>
    <MudText Typo="Typo.body2">
        Pas star 3 godine, miran i druželjubiv.
    </MudText>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Class="mt-2">
        Detalji
    </MudButton>
</MudPaper>

<MudPaper Class="pa-4" Elevation="2">
    <MudImage Src="images/bobtail.jpg"
              Alt="Životinje u azilu"
              Fluid="true"
              Class="mb-3" />

    <MudText Typo="Typo.h6">Sve životinje</MudText>
    <MudText Typo="Typo.body2">
        Pregled životinja, njihovog statusa i osnovnih podataka.
    </MudText>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Class="mt-3">
        Otvori pregled
    </MudButton>
</MudPaper>