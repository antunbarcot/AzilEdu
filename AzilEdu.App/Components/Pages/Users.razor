@page "/users"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using AzilEdu.App.Services
@using AzilEdu.Shared.DTOs

@inject HttpClient Http
@inject CurrentUserService CurrentUser

<PageTitle>Korisnici i uloge</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Korisnici i uloge</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Administrator upravlja računima, dodjeljuje više uloga i povezuje račun
    s poslovnim profilom donatora, volontera ili djelatnika.
</MudText>

@if (!CurrentUser.HasRole("Admin"))
{
    <MudAlert Severity="Severity.Error">Ovu stranicu može otvoriti samo administrator.</MudAlert>
}
else if (isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">@successMessage</MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" lg="7">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.h6">Korisnički računi</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartCreate">
                        Novi korisnik
                    </MudButton>
                </MudStack>

                <MudTable Items="users" Hover="true" Dense="true" Bordered="true">
                    <HeaderContent>
                        <MudTh>Korisnik</MudTh>
                        <MudTh>Uloge</MudTh>
                        <MudTh>Profil</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Korisnik">
                            <MudText Typo="Typo.body1">@context.DisplayName</MudText>
                            <MudText Typo="Typo.caption">@context.Email</MudText>
                        </MudTd>
                        <MudTd DataLabel="Uloge">
                            @foreach (var role in context.Roles)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="me-1 mb-1">
                                    @role
                                </MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Profil">@GetProfileDisplay(context)</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="@(context.IsActive ? Color.Success : Color.Default)">
                                @(context.IsActive ? "Aktivan" : "Neaktivan")
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           title="Uredi korisnika"
                                           OnClick="@(() => StartEdit(context))" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-3">Nema korisničkih računa.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">
                    @(editingId.HasValue ? "Uredi korisnika" : "Novi korisnik")
                </MudText>

                <EditForm Model="model" OnValidSubmit="SaveUser" FormName="user-admin-form">
                    <MudTextField Label="Prikazno ime"
                                  @bind-Value="model.DisplayName"
                                  Required="true"
                                  Variant="Variant.Outlined"
                                  Class="mb-3" />

                    <MudTextField Label="E-mail"
                                  @bind-Value="model.Email"
                                  Required="true"
                                  Variant="Variant.Outlined"
                                  Class="mb-3" />

                    <MudTextField Label="@(editingId.HasValue ? "Nova lozinka (ostavi prazno bez promjene)" : "Lozinka")"
                                  @bind-Value="model.Password"
                                  InputType="InputType.Password"
                                  Required="@(!editingId.HasValue)"
                                  Variant="Variant.Outlined"
                                  Class="mb-3" />

                    <MudSwitch T="bool" @bind-Value="model.IsActive" Color="Color.Success" Class="mb-3">
                        Aktivan račun
                    </MudSwitch>

                    <MudText Typo="Typo.subtitle2" Class="mb-2">Uloge</MudText>
                    <MudStack Spacing="0" Class="mb-3">
                        @foreach (var role in roles)
                        {
                            <MudCheckBox T="bool"
                                         Value="@model.RoleIds.Contains(role.Id)"
                                         ValueChanged="@(value => SetRole(role.Id, value))"
                                         Label="@($"{role.DisplayName} ({role.Name})")" />
                        }
                    </MudStack>

                    <MudSelect T="int?" Label="Povezani volonter"
                               @bind-Value="model.VolunteerId"
                               Clearable="true" Variant="Variant.Outlined" Class="mb-3">
                        @foreach (var item in volunteers)
                        {
                            <MudSelectItem T="int?" Value="@((int?)item.Id)">@item.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int?" Label="Povezani donator"
                               @bind-Value="model.DonorId"
                               Clearable="true" Variant="Variant.Outlined" Class="mb-3">
                        @foreach (var item in donors)
                        {
                            <MudSelectItem T="int?" Value="@((int?)item.Id)">@item.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int?" Label="Povezani djelatnik"
                               @bind-Value="model.EmployeeId"
                               Clearable="true" Variant="Variant.Outlined" Class="mb-4">
                        @foreach (var item in employees)
                        {
                            <MudSelectItem T="int?" Value="@((int?)item.Id)">@item.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudStack Row="true">
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="isSaving">
                            @(isSaving ? "Spremam..." : "Spremi")
                        </MudButton>
                        <MudButton Variant="Variant.Text" OnClick="StartCreate" Disabled="isSaving">
                            Odustani
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private List<UserAdminDto> users = new();
    private List<RoleDto> roles = new();
    private List<LookupDto> volunteers = new();
    private List<LookupDto> donors = new();
    private List<LookupDto> employees = new();
    private SaveUserAdminDto model = NewModel();
    private int? editingId;
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.HasRole("Admin"))
        {
            isLoading = false;
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            users = await Http.GetFromJsonAsync<List<UserAdminDto>>("api/users") ?? new();
            roles = await Http.GetFromJsonAsync<List<RoleDto>>("api/users/roles") ?? new();
            volunteers = await Http.GetFromJsonAsync<List<LookupDto>>("api/volunteers/lookup") ?? new();
            donors = await Http.GetFromJsonAsync<List<LookupDto>>("api/donors/lookup") ?? new();
            employees = await Http.GetFromJsonAsync<List<LookupDto>>("api/employees/lookup") ?? new();
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Podatke nije moguće učitati: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartCreate()
    {
        editingId = null;
        model = NewModel();
        errorMessage = null;
        successMessage = null;
    }

    private void StartEdit(UserAdminDto user)
    {
        editingId = user.Id;
        model = new SaveUserAdminDto
        {
            Email = user.Email,
            DisplayName = user.DisplayName,
            IsActive = user.IsActive,
            RoleIds = user.RoleIds.ToList(),
            VolunteerId = user.VolunteerId,
            DonorId = user.DonorId,
            EmployeeId = user.EmployeeId
        };
        errorMessage = null;
        successMessage = null;
    }

    private void SetRole(int roleId, bool selected)
    {
        if (selected && !model.RoleIds.Contains(roleId))
            model.RoleIds.Add(roleId);
        else if (!selected)
            model.RoleIds.Remove(roleId);
    }

    private async Task SaveUser()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            HttpResponseMessage response;

            if (editingId.HasValue)
                response = await Http.PutAsJsonAsync($"api/users/{editingId.Value}", model);
            else
                response = await Http.PostAsJsonAsync("api/users", model);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            successMessage = editingId.HasValue
                            ? "Korisnik je ažuriran. Nove uloge vrijede nakon sljedeće prijave."
                            : "Korisnik je kreiran.";

            editingId = null;
            model = NewModel();
            users = await Http.GetFromJsonAsync<List<UserAdminDto>>("api/users") ?? new();
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Korisnika nije moguće spremiti: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static SaveUserAdminDto NewModel() => new() { IsActive = true };

    private static string GetProfileDisplay(UserAdminDto user)
    {
        var profiles = new[] { user.EmployeeName, user.VolunteerName, user.DonorName }
            .Where(value => !string.IsNullOrWhiteSpace(value));

        return string.Join(", ", profiles.DefaultIfEmpty("Nije povezan"));
    }
}