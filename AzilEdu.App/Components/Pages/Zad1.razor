@page "/Zad1"
@rendermode InteractiveServer

<h1>Promjena boje teksta</h1>

<p class="@nazivKlase">
    Ovo je poruka.
</p>

<button @onclick="PromijeniBoju">
    Promijeni boju
</button>

@code {
    string nazivKlase = "tekst-plavi";

    void PromijeniBoju()
    {
        if (nazivKlase == "tekst-plavi")
        {
            nazivKlase = "tekst-crveni";
        }
        else
        {
            nazivKlase = "tekst-plavi";
        }
    }
}