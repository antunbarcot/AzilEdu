@page "/Zad4"
@rendermode InteractiveServer

<h1>Prikaz i skrivanje poruke</h1>
<button @onclick="PromijeniPrikaz"> Prikaži/Sakrij</button>

@if (prikazi)
{
    <p class="poruka">
        Ovo je poruka koja se prikazuje.
    </p>
}

@code{
    bool prikazi = false;
    void PromijeniPrikaz()
    {
        prikazi = !prikazi;
    }
}
