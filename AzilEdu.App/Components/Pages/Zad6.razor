@page "/Zad6"
@rendermode InteractiveServer

<p>Zadaci</p>
<label>Novi zadatak:
    <input @bind="novizdk" />
</label>

<button @onclick="DodajZdk">Dodaj</button>
<ul>
    @foreach (string zdk in zadaci)
    {
        <li>@zdk</li>
    }
</ul>

@code{
    string novizdk = "";
    List<string> zadaci = new()
    {
        "Operi suđe",
        "Baci smeće",
    };
    void DodajZdk()
    {
        if (!string.IsNullOrWhiteSpace(novizdk))
        {
            zadaci.Add(novizdk);
            novizdk = "";
        }
    }
}
